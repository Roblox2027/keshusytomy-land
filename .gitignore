# Entorno y herramientas

# Sistema operativo / editores
Thumbs.db
Desktop.ini
.DS_Store

# Rojo (salidas y datos locales, nunca el binario del proyecto)
*.rbxl
*.rbxlx
*.rbxmx
*.rbxl.lock
*.rbxlx.lock
# El sourcemap se regenera con `rojo sourcemap` en cada build: es un
# artefacto, no fuente. Versionarlo haria que cada build del servidor
# generase un diff de un archivo que nadie lee.
sourcemap.json
redist/
rojo.zip

# Binarios de Rojo locales: son herramientas, nunca codigo del juego
rojo/
rojo-*/

# Sistema de control de versiones
.git/
.gitattributes.bak

# Editores
# `settings.json` es configuracion de la maquina de cada uno y NO se
# versiona. Las recomendaciones de extensiones y las tareas SI: son
# parte del entorno reproducible del proyecto.
#
# OJO: hay que usar `.vscode/*` y NO `.vscode/`. Git no desciende en
# un directorio ignorado, asi que con `.vscode/` las reglas `!` de
# abajo nunca se evaluan y `extensions.json` seguiria ignorado.
# Verificado con `git check-ignore -v`.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/

# Bootstrap IA
# Se versiona: .ai/AI_CONTEXT.md, .ai/spec/, .ai/qa/  (contrato de producto)
# Se ignora: artefactos locales de ejecucion
.ai/runtime/
.ai/snapshots/
.ai/reports/
.ai/plans/
.ai-bootstrap-backup/

# Herramientas / caches del entorno
.cache/
.gradle/
.android/
node_modules/

# Artefactos
dist/
build/
out/
logs/
*.log
*.tmp
*.temp
*.bak
*.zip
*.7z
*.exe

# Debris de sesiones de depuracion (Master Script 15: NO se borran; se
# excluyen del versionado porque nunca han estado en HEAD - `git ls-files
# tmp_*` = 0). Versionarlos anadiria ~100 ficheros de una sesion y una
# copia anidada entera del proyecto (.kilo/worktrees) al historial.
/tmp_*.js
/tmp_*.lua
/patch_rim.js
/probe_exit.js
/run_why.js
/search_why.js
/gitdiff.txt
/Install-RobloxAIKit.ps1
*.rbxm
/.kilo/
/.ai/tmp/
/.ai/tmp_diag*.js
/.ai/gen_out.txt
/.ai/nav_out.txt
/.ai/nav_why.txt
/.ai/why_out.txt
/.ai/why_search.txt
/.ai/fase1_status_*.txt

# Artefacto accidental: typo de nombre, 0 bytes, 0 referencias en src/ ni
# tests/ (el real es MonsterDefinitions.lua). Se conserva en disco pero NO
# se versiona - un modulo vacion homonimo en Shared es trampa para el ojo.
/src/ReplicatedStorage/Shared/MosterDefinitions.lua

# El estado persistente de Cline se versiona COMPLETO (Master Script 30),
# tambien el HISTORY.log, aunque `*.log` ignora los logs genericos.
!.cline/HISTORY.log

